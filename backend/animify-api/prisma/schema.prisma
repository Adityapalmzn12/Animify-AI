generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PlanType {
  FREE_TRIAL
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobType {
  STYLIZE
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  AVATAR
  DUB
  SUBTITLE
  VOICE
  SCRIPT
  IMAGE_GEN
  BG_REMOVE
  EDIT_TRIM
  EDIT_MERGE
  EDIT_CROP
  EDIT_FILTER
  EDIT_EXPORT
}

enum FileType {
  INPUT
  OUTPUT
  THUMBNAIL
  PREVIEW
  AUDIO
  SUBTITLE
  IMAGE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  VIDEO_COMPLETE
  SUBSCRIPTION
  CREDITS_LOW
  JOB_FAILED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  PASSWORD_RESET
}

enum CreditTxnType {
  GRANT
  DEBIT
  REFUND
  PURCHASE
  PROMO
}

enum AssetType {
  VIDEO
  IMAGE
  AUDIO
  SUBTITLE
  OTHER
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  avatarUrl     String?    @map("avatar_url")
  googleId      String?    @unique @map("google_id")
  appleId       String?    @unique @map("apple_id")
  emailVerified Boolean    @default(false) @map("email_verified")
  passwordHash  String?    @map("password_hash")
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  creditBalance Int        @default(0) @map("credit_balance")
  /// Owner/admin INR earnings from 55% commission on user purchases
  earningsBalanceInr Decimal @default(0) @map("earnings_balance_inr") @db.Decimal(12, 2)
  fcmToken      String?    @map("fcm_token")
  locale        String     @default("en")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  subscription   Subscription?
  payments       Payment[]
  videoJobs      VideoJob[]
  usage          Usage[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  downloads      Download[]
  refreshTokens  RefreshToken[]
  projects       Project[]
  assets         Asset[]
  creditLedgers  CreditLedger[]
  favorites      Favorite[]
  voices         Voice[]
  commissionsAsBuyer CommissionEntry[] @relation("CommissionBuyer")
  commissionsAsOwner CommissionEntry[] @relation("CommissionOwner")

  @@map("users")
}

/// Auto 55% owner commission + 45% API budget on every credit purchase
model CommissionEntry {
  id             String   @id @default(uuid())
  buyerUserId    String   @map("buyer_user_id")
  ownerUserId    String?  @map("owner_user_id")
  paymentId      String?  @map("payment_id")
  source         String   // wallet_topup | subscription | renewal
  grossInr       Decimal  @map("gross_inr") @db.Decimal(12, 2)
  apiBudgetInr   Decimal  @map("api_budget_inr") @db.Decimal(12, 2)
  commissionInr  Decimal  @map("commission_inr") @db.Decimal(12, 2)
  marginPercent  Int      @default(55) @map("margin_percent")
  creditsGranted Int      @default(0) @map("credits_granted")
  currency       String   @default("INR")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  buyer User  @relation("CommissionBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  owner User? @relation("CommissionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([buyerUserId])
  @@index([ownerUserId])
  @@index([createdAt])
  @@map("commission_entries")
}

model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  coverUrl    String?  @map("cover_url")
  isFavorite  Boolean  @default(false) @map("is_favorite")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs    VideoJob[]
  assets  Asset[]

  @@index([userId])
  @@map("projects")
}

model Asset {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  projectId   String?   @map("project_id")
  type        AssetType
  storageKey  String    @map("storage_key")
  name        String
  mimeType    String    @map("mime_type")
  sizeBytes   BigInt    @map("size_bytes")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@map("assets")
}

model CreditLedger {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  type        CreditTxnType
  amount      Int
  balanceAfter Int          @map("balance_after")
  reason      String?
  jobId       String?       @map("job_id")
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("credit_ledgers")
}

model Voice {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  name        String
  provider    String
  providerId  String   @map("provider_id")
  language    String   @default("en")
  previewUrl  String?  @map("preview_url")
  isClone     Boolean  @default(false) @map("is_clone")
  isPublic    Boolean  @default(false) @map("is_public")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("voices")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  jobId     String   @map("job_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  VideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("favorites")
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique @map("user_id")
  planType         PlanType           @map("plan_type")
  status           SubscriptionStatus
  startedAt        DateTime           @map("started_at")
  expiresAt        DateTime           @map("expires_at")
  videoLimit       Int                @map("video_limit")
  minutesLimit     Int                @map("minutes_limit")
  autoRenew        Boolean            @default(true) @map("auto_renew")
  stripeCustomerId String?            @map("stripe_customer_id")
  stripeSubId      String?            @map("stripe_sub_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  subscriptionId String?         @map("subscription_id")
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("INR")
  status         PaymentStatus
  provider       PaymentProvider
  providerId     String?         @map("provider_id")
  invoiceUrl     String?         @map("invoice_url")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model VideoJob {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  projectId    String?   @map("project_id")
  templateId   String?   @map("template_id")
  jobType      JobType   @default(STYLIZE) @map("job_type")
  provider     String    @default("oss")
  creditsCost  Int       @default(0) @map("credits_cost")
  status       JobStatus @default(PENDING)
  progress     Int       @default(0)
  currentStep  String?   @map("current_step")
  errorMessage String?   @map("error_message")
  prompt       String?
  inputFileId  String?   @map("input_file_id")
  outputFileId String?   @map("output_file_id")
  settings     Json      @default("{}")
  priority     Int       @default(0)
  bullJobId    String?   @map("bull_job_id")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template   Template?   @relation(fields: [templateId], references: [id])
  inputFile  VideoFile?  @relation("InputFile", fields: [inputFileId], references: [id])
  outputFile VideoFile?  @relation("OutputFile", fields: [outputFileId], references: [id])
  favorites  Favorite[]

  @@index([userId])
  @@index([status])
  @@index([jobType])
  @@index([projectId])
  @@map("video_jobs")
}

model VideoFile {
  id                   String    @id @default(uuid())
  type                 FileType
  storageKey           String    @map("storage_key")
  originalName         String    @map("original_name")
  mimeType             String    @map("mime_type")
  sizeBytes            BigInt    @map("size_bytes")
  durationSeconds      Decimal?  @map("duration_seconds") @db.Decimal(10, 2)
  width                Int?
  height               Int?
  frameRate            Decimal?  @map("frame_rate") @db.Decimal(5, 2)
  downloadUrl          String?   @map("download_url")
  downloadUrlExpiresAt DateTime? @map("download_url_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  inputJobs  VideoJob[] @relation("InputFile")
  outputJobs VideoJob[] @relation("OutputFile")
  downloads  Download[]

  @@index([type])
  @@map("video_files")
}

model Template {
  id           String   @id @default(uuid())
  name         String
  description  String?
  previewUrl   String   @map("preview_url")
  thumbnailUrl String   @map("thumbnail_url")
  config       Json
  category     String
  tags         String[] @default([])
  isPremium    Boolean  @default(false) @map("is_premium")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  usageCount   Int      @default(0) @map("usage_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  videoJobs VideoJob[]

  @@index([category])
  @@index([isActive])
  @@map("templates")
}

model Usage {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  videosUsed       Int      @default(0) @map("videos_used")
  minutesUsed      Decimal  @default(0) @map("minutes_used") @db.Decimal(10, 2)
  storageUsedBytes BigInt   @default(0) @map("storage_used_bytes")
  apiCalls         Int      @default(0) @map("api_calls")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd])
  @@index([userId])
  @@map("usage")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  body      String
  type      NotificationType
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  adminUserId  String?  @map("admin_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id])
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         AdminRole
  permissions  String[]  @default([])
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admin_users")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  maxUses       Int?         @map("max_uses")
  usedCount     Int          @default(0) @map("used_count")
  minAmount     Decimal?     @map("min_amount") @db.Decimal(10, 2)
  creditGrant   Int          @default(0) @map("credit_grant")
  validFrom     DateTime     @map("valid_from")
  validUntil    DateTime     @map("valid_until")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("coupons")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Download {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  videoFileId  String   @map("video_file_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoFile VideoFile @relation(fields: [videoFileId], references: [id])

  @@map("downloads")
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  tokenHash       String    @map("token_hash")
  familyId        String    @map("family_id")
  deviceInfo      String?   @map("device_info")
  ipAddress       String?   @map("ip_address")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByHash  String?   @map("replaced_by_hash")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(uuid())
  email       String
  codeHash    String     @map("code_hash")
  purpose     OtpPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(3) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  verifiedAt  DateTime?  @map("verified_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("otp_codes")
}
