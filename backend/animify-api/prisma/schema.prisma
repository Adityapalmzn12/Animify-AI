generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum PlanType {
  FREE_TRIAL
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum FileType {
  INPUT
  OUTPUT
  THUMBNAIL
  PREVIEW
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  VIDEO_COMPLETE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  PASSWORD_RESET
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  name          String
  avatarUrl     String?    @map("avatar_url")
  googleId      String?    @unique @map("google_id")
  emailVerified Boolean    @default(false) @map("email_verified")
  passwordHash  String?    @map("password_hash")
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  subscription   Subscription?
  payments       Payment[]
  videoJobs      VideoJob[]
  usage          Usage[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  downloads      Download[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model Subscription {
  id           String             @id @default(uuid())
  userId       String             @unique @map("user_id")
  planType     PlanType           @map("plan_type")
  status       SubscriptionStatus
  startedAt    DateTime           @map("started_at")
  expiresAt    DateTime           @map("expires_at")
  videoLimit   Int                @map("video_limit")
  minutesLimit Int                @map("minutes_limit")
  autoRenew    Boolean            @default(true) @map("auto_renew")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  subscriptionId String?         @map("subscription_id")
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("INR")
  status         PaymentStatus
  provider       PaymentProvider
  providerId     String?         @map("provider_id")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model VideoJob {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  templateId   String?   @map("template_id")
  status       JobStatus @default(PENDING)
  progress     Int       @default(0)
  currentStep  String?   @map("current_step")
  errorMessage String?   @map("error_message")
  inputFileId  String    @map("input_file_id")
  outputFileId String?   @map("output_file_id")
  settings     Json
  priority     Int       @default(0)
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  Template?  @relation(fields: [templateId], references: [id])
  inputFile VideoFile  @relation("InputFile", fields: [inputFileId], references: [id])
  outputFile VideoFile? @relation("OutputFile", fields: [outputFileId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("video_jobs")
}

model VideoFile {
  id                    String    @id @default(uuid())
  type                  FileType
  storageKey            String    @map("storage_key")
  originalName          String    @map("original_name")
  mimeType              String    @map("mime_type")
  sizeBytes             BigInt    @map("size_bytes")
  durationSeconds       Decimal?  @map("duration_seconds") @db.Decimal(10, 2)
  width                 Int?
  height                Int?
  frameRate             Decimal?  @map("frame_rate") @db.Decimal(5, 2)
  downloadUrl           String?   @map("download_url")
  downloadUrlExpiresAt  DateTime? @map("download_url_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  inputJobs  VideoJob[] @relation("InputFile")
  outputJobs VideoJob[] @relation("OutputFile")
  downloads  Download[]

  @@index([type])
  @@map("video_files")
}

model Template {
  id          String   @id @default(uuid())
  name        String
  description String?
  previewUrl  String   @map("preview_url")
  thumbnailUrl String  @map("thumbnail_url")
  config      Json
  category    String
  tags        String[] @default([])
  isPremium   Boolean  @default(false) @map("is_premium")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  videoJobs VideoJob[]

  @@index([category])
  @@index([isActive])
  @@map("templates")
}

model Usage {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  videosUsed      Int      @default(0) @map("videos_used")
  minutesUsed     Decimal  @default(0) @map("minutes_used") @db.Decimal(10, 2)
  storageUsedBytes BigInt  @default(0) @map("storage_used_bytes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart, periodEnd])
  @@index([userId])
  @@map("usage")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  body      String
  type      NotificationType
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  adminUserId  String?  @map("admin_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id])
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         AdminRole
  permissions  String[]  @default([])
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@map("admin_users")
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  maxUses       Int?         @map("max_uses")
  usedCount     Int          @default(0) @map("used_count")
  minAmount     Decimal?     @map("min_amount") @db.Decimal(10, 2)
  validFrom     DateTime     @map("valid_from")
  validUntil    DateTime     @map("valid_until")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("coupons")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Download {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  videoFileId  String   @map("video_file_id")
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoFile VideoFile @relation(fields: [videoFileId], references: [id])

  @@map("downloads")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id          String     @id @default(uuid())
  email       String
  codeHash    String     @map("code_hash")
  purpose     OtpPurpose
  attempts    Int        @default(0)
  maxAttempts Int        @default(3) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  verifiedAt  DateTime?  @map("verified_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("otp_codes")
}
