# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/animify_dev?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=animify-storage
R2_PUBLIC_URL=
R2_UPLOAD_URL_EXPIRY=3600
R2_DOWNLOAD_URL_EXPIRY=86400

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Animify AI <noreply@animify.ai>

# Payment
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Providers
AI_PROVIDER=fal
FAL_API_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=

# Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_VIDEO_DURATION_SECONDS=180
FREE_TRIAL_VIDEO_LIMIT=3
PREMIUM_VIDEO_LIMIT=45
PREMIUM_MINUTES_LIMIT=450
PREMIUM_PRICE_INR=49

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPLOAD_MAX=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true
